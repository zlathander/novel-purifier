{
  "regex_watermarks": [
    "^\\s*本书首发.*$",
    "^\\s*更新不易，记得分享网\\s*$",
    "^\\s*.*全手打无错站\\s*$",
    "^\\s*【(?:记住全网最快小说站|写到这里我希望读者记一下我们域名).*】\\s*$",
    "^\\s*更多精彩小说，请访问：.*$",
    "^\\s*来源：.*$",
    "^\\s*网址：https?://.*$",
    "^\\s*章节范围：.*$",
    "^\\s*(?:&gt;|>)\\s*$",
    "^\\s*（请记住网站，观看最快的章节更新）\\s*$",
    "^\\s*最⊥新⊥小⊥说⊥在.*$",
    "^\\s*记住我们网\\s*$"
  ],
  "inline_replacements": [
    {
      "pattern": "101[?]+.[?]+",
      "replacement": ""
    },
    {
      "pattern": "[?]{5,}\\.[?]{3,}",
      "replacement": ""
    },
    {
      "pattern": "最⊥新⊥小⊥说⊥在⊥+首⊥发！?",
      "replacement": ""
    }
  ],
