{
  "regex_watermarks": [
    "^\\s*本书首发.*$",
    "^\\s*更新不易，记得分享网\\s*$",
    "^\\s*.*全手打无错站\\s*$",
    "^\\s*【(?:记住全网最快小说站|写到这里我希望读者记一下我们域名).*】\\s*$",
    "^\\s*更多精彩小说，请访问：.*$",
    "^\\s*来源：.*$",
    "^\\s*网址：https?://.*$",
    "^\\s*章节范围：.*$",
    "^\\s*(?:&gt;|>)\\s*$"
  ],
  "inline_replacements": [
    {
      "pattern": "101[?]+.[?]+",
      "replacement": ""
    },
    {
      "pattern": "[?]{5,}\\.[?]{3,}",
      "replacement": ""
    }
  ],
  "exact_matches": [
    {
      "pattern": "什幺",
      "replacement": "什么"
    },
    {
      "pattern": "那幺",
      "replacement": "那么"
    },
    {
      "pattern": "怎幺",
      "replacement": "怎么"
    },
    {
      "pattern": "擡",
      "replacement": "抬"
    },
    {
      "pattern": "。。",
      "replacement": "。"
    }
  ],
  "title_suffixes": [
